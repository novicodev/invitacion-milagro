---
const date = new Date('2026-10-10T20:00:00-05:00');
const mapUrl = 'https://maps.app.goo.gl/BbXqjyhBYongWPFz7';
const message = encodeURIComponent('Hola, soy [Tu nombre]. Confirmo mi asistencia a los XV años de Milagro Rodriguez Polo.');
const phoneNumbers = ['573006180824', '573002702453'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f0ed" />
    <title>Mis XV · Milagro Rodriguez Polo</title>
  </head>
  <body>
    <div class="review-watermark" aria-hidden="true">VISTA PREVIA · REVISIÓN</div>
    <main>
      <section class="cover">
        <div class="cover-art" aria-hidden="true"></div>
        <video class="cover-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
          <source src="/san-felipe.mp4" type="video/mp4" />
        </video>
        <div class="cover-copy">
          <p class="eyebrow">Una noche para recordar</p>
          <p class="small-title">Mis</p>
          <h1>XV</h1>
          <p class="name">Milagro</p>
          <p class="surname">Rodriguez Polo</p>
          <p class="date">10 · 10 · 2026</p>
          <a class="scroll-arrow" href="#historia" aria-label="Continuar a la invitación">↓</a>
        </div>
      </section>

      <section class="story section" id="historia">
        <p class="eyebrow">Una nueva etapa</p>
        <div class="story-grid">
          <h2>Hay momentos<br />que se quedan<br /><em>para siempre.</em></h2>
          <div class="copy">
            <p>Hoy quiero celebrar una nueva etapa rodeada de las personas que hacen especial mi historia.</p>
            <p>Con mucha ilusión, quiero compartir contigo esta noche tan importante. Tu presencia será el regalo más bonito para comenzar a escribir lo que sigue.</p>
            <p class="signature">Con cariño,<br /><strong>Milagro</strong></p>
          </div>
        </div>
      </section>

      <section class="event section">
        <p class="eyebrow">Guarda la fecha</p>
        <div class="event-card">
          <div><span class="label">Sábado</span><strong class="date-display"><b>10</b><span>octubre<br /><small>2026</small></span></strong></div>
          <div><span class="label">Recepción</span><strong>8:00<br /><small>p. m.</small></strong></div>
        </div>
        <div class="countdown" data-countdown data-target={date.toISOString()}><div><b data-days>00</b><span>días</span></div><div><b data-hours>00</b><span>horas</span></div><div><b data-minutes>00</b><span>minutos</span></div><div><b data-seconds>00</b><span>segundos</span></div></div>
        <p class="punctual">Te esperamos con puntualidad para disfrutar desde el inicio de la ceremonia y compartir más tiempo juntos.</p>
      </section>

      <section class="venue section">
        <div class="venue-photo" aria-hidden="true"></div>
        <div class="venue-copy">
          <p class="eyebrow">El lugar</p>
          <h2>La Mona<br /><em>Salón de Eventos</em></h2>
          <p>y Restaurante</p>
          <address>Cra. 3 #45-15, Ciudadela 20 de Julio<br />Barranquilla, Atlántico</address>
          <a class="button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar <span>↗</span></a>
        </div>
      </section>

      <section class="details section">
        <p class="eyebrow">Detalles de la noche</p>
        <h2 class="details-title">Todo pensado para<br /><em>celebrar juntos.</em></h2>
        <div class="detail-grid">
          <article><span class="detail-symbol">✦</span><h3>Código de<br /><em>vestimenta</em></h3><p><strong>Tipo cóctel</strong><br />Reservamos el color <span class="reserved-colors"><span class="rose-word">oro rosa</span> y <span class="gold-word">dorado</span></span> para la quinceañera.</p></article>
          <article><span class="detail-symbol">♡</span><h3>Mesa de<br /><em>regalos</em></h3><p><strong>Lluvia de sobres</strong><br />Tu presencia será nuestro regalo más bonito.</p></article>
        </div>
      </section>

      <section class="photos section">
        <p class="eyebrow">La historia continúa</p>
        <div class="photos-grid"><div><h2>Comparte<br /><em>tus fotos.</em></h2><p>Guarda entre 3 y 6 fotos favoritas de la noche. Próximamente compartiremos la carpeta para reunir todos nuestros recuerdos.</p><button class="button is-disabled" type="button" disabled>Carpeta próximamente</button></div><div class="photo-frame" aria-hidden="true"><span>♡</span><small>Momentos para recordar</small></div></div>
      </section>

      <section class="rsvp section">
        <p class="eyebrow">Confirma tu asistencia</p>
        <h2>¿Nos<br /><em>acompañas?</em></h2>
        <p>Por favor confirmar antes del <strong>01 de octubre</strong>.</p>
        <div class="actions">{phoneNumbers.map((phone, index) => <a class="button button-light rsvp-link" data-phone={phone} href={`https://wa.me/${phone}?text=${message}`} target="_blank" rel="noreferrer">WhatsApp {index + 1} ↗</a>)}</div>
      </section>

      <footer><p class="hashtag">#Mis15milagro</p><p>♪ Cree y atrévete · Hanna y Ashley</p><p class="footer-name">Milagro Rodriguez Polo · XV</p><p class="photo-credit">Foto de fondo: <a href="https://commons.wikimedia.org/wiki/File:Colombia,_Cartagena,_Castillo_de_San_Felipe_de_Barajas.jpg" target="_blank" rel="noreferrer">Wikimedia Commons</a> · CC BY-SA 4.0</p></footer>
    </main>
    <script is:inline>
      const countdown = document.querySelector('[data-countdown]');
      const tick = () => { const diff = Math.max(0, new Date(countdown.dataset.target).getTime() - Date.now()); const values = [Math.floor(diff / 86400000), Math.floor(diff / 3600000) % 24, Math.floor(diff / 60000) % 60, Math.floor(diff / 1000) % 60]; ['days','hours','minutes','seconds'].forEach((key, i) => document.querySelector(`[data-${key}]`).textContent = String(values[i]).padStart(2, '0')); };
      tick(); setInterval(tick, 1000);
    </script>
  </body>
</html>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Parisienne&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');
:root{--ink:#3a2630;--rose:#a96379;--blush:#f4e1e2;--cream:#fbf6f1;--gold:#c49a62;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:15px/1.65 var(--sans)}main{overflow:hidden}.cover{min-height:100svh;position:relative;display:grid;place-items:center;text-align:center;color:#fff8f3;background:#8b5167}.cover-art,.venue-photo{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=1800&q=88') center/cover}.cover-art{filter:saturate(.65);opacity:.55}.cover:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#3a172944,#3a1720c7)}.cover-copy,.monogram{position:relative;z-index:1}.cover-copy{width:min(92%,650px)}.monogram{position:absolute;z-index:2;top:2rem;left:2rem;letter-spacing:.2em;color:#f2d6bd}.eyebrow,.label{letter-spacing:.18em;text-transform:uppercase;font-size:.7rem}.cover .eyebrow{color:#f2d6bd}.small-title{font:italic 1.6rem var(--serif);margin:4rem 0 0}.cover h1{font:clamp(10rem,35vw,19rem)/.8 var(--serif);font-weight:400;letter-spacing:-.08em;margin:.4rem 0;color:#e6bd83}.name{font-size:1rem;letter-spacing:.3em;text-transform:uppercase;margin:3rem 0 .7rem}.date{letter-spacing:.2em}.scroll-cue{display:inline-flex;flex-direction:column;gap:.5rem;margin-top:4rem;color:#fff;text-decoration:none;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}.scroll-cue span{font-size:1.5rem;color:#e6bd83}.section{padding:clamp(5rem,12vw,10rem) clamp(1.5rem,8vw,9rem)}.eyebrow{color:var(--rose);margin:0 0 3.5rem}.story{background:#fffdfb}.story-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:10vw;align-items:end}.story h2,.venue h2,.rsvp h2{font:400 clamp(3.4rem,8vw,7.5rem)/.95 var(--serif);letter-spacing:-.07em;margin:0}.story h2 em,.venue h2 em,.rsvp h2 em{color:var(--rose)}.copy{max-width:27rem;color:#765d64}.copy>p:first-child{font:1.55rem/1.3 var(--serif);color:var(--ink)}.signature{margin-top:3rem;font:italic 1.2rem var(--serif);color:var(--rose)}.signature strong{font-size:1.6rem}.event{background:var(--blush)}.event-card{display:grid;grid-template-columns:1fr 1fr;max-width:700px;border-top:1px solid #c49a62;padding-top:2.2rem;gap:2rem}.event-card .label{display:block;color:var(--rose);margin-bottom:1.3rem}.event-card strong{font:400 clamp(1.7rem,4vw,3.7rem)/1.05 var(--serif)}.event-card small{font-size:1rem}.countdown{display:flex;gap:clamp(1rem,6vw,4rem);margin-top:5rem;border-top:1px solid #c49a62;padding-top:1.8rem}.countdown div{display:grid}.countdown b{font:400 clamp(2rem,6vw,4rem)/1 var(--serif);color:var(--rose)}.countdown span{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:#765d64}.punctual{max-width:30rem;margin-top:3rem;color:#765d64;font:italic 1rem var(--serif)}.venue{display:grid;grid-template-columns:1fr 1fr;min-height:70vh;gap:8vw;align-items:center;background:#fffdfb}.venue-photo{position:relative;inset:auto;min-height:500px;background-position:center 30%;filter:saturate(.6)}.venue-copy h2{font-size:clamp(3.3rem,7vw,6.5rem)}.venue-copy>p:not(.eyebrow){color:var(--rose);font:italic 1.2rem var(--serif);margin:.5rem 0 2rem}.venue address{font-style:normal;color:#765d64}.button{display:inline-flex;gap:2rem;margin-top:2rem;padding:.85rem 1.2rem;border:1px solid var(--rose);color:var(--rose);text-decoration:none;text-transform:uppercase;letter-spacing:.12em;font-size:.7rem}.button:hover{background:var(--rose);color:#fff}.details{background:var(--ink);color:#fff8f3}.details .eyebrow{color:#e6bd83}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#c49a62}.detail-grid article{background:var(--ink);padding:2rem}.number{color:#e6bd83}.detail-grid h3{font:400 clamp(2rem,4vw,3.5rem)/.95 var(--serif);margin:3rem 0 1.5rem}.detail-grid h3 em{color:#e6bd83}.detail-grid p{color:#f4e1e2}.rsvp{text-align:center;background:var(--rose);color:#fff8f3}.rsvp .eyebrow{color:#f4e1e2}.rsvp h2{font-size:clamp(4rem,13vw,10rem)}.rsvp>p:not(.eyebrow){color:#f4e1e2}.actions{display:flex;justify-content:center;gap:.7rem;flex-wrap:wrap}.button-light{color:#fff8f3;border-color:#fff8f3}.button-light:hover{background:#fff8f3;color:var(--rose)}footer{padding:4rem 1rem;text-align:center;background:var(--cream);color:#765d64}footer .hashtag{font:italic 2rem var(--serif);color:var(--rose)}footer .footer-name{margin-top:3rem;letter-spacing:.2em;text-transform:uppercase;font-size:.7rem}@media(max-width:700px){.story-grid,.venue{grid-template-columns:1fr}.venue-photo{min-height:360px;order:2}.detail-grid{grid-template-columns:1fr}.detail-grid article{padding:1.5rem}.event-card strong{font-size:1.8rem}}
.review-watermark{position:fixed;z-index:20;top:50%;left:-10%;width:120%;transform:rotate(-18deg);pointer-events:none;text-align:center;color:var(--rose);font:500 clamp(1.4rem,5vw,4rem)/1 var(--sans);letter-spacing:.28em;opacity:.13;white-space:nowrap}.cover-copy{position:relative;z-index:1}.date-display{display:flex!important;align-items:center;gap:1rem}.date-display b{font:400 clamp(4rem,9vw,7rem)/.8 var(--serif);color:var(--rose)}.date-display span{font:italic 1.3rem/1.1 var(--serif);color:var(--ink)}.date-display small{font:normal .8rem var(--sans);letter-spacing:.15em;text-transform:uppercase}.scroll-arrow{display:inline-block;margin-top:4rem;color:#e6bd83;text-decoration:none;font:2rem/1 var(--serif);animation:float-arrow 2s ease-in-out infinite}.scroll-arrow:focus-visible{outline:1px solid #fff;padding:.3rem}@keyframes float-arrow{50%{transform:translateY(7px)}}.button.is-disabled{opacity:.6;cursor:not-allowed}.photos{background:#fffdfb}.photos-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center}.photos-grid p{max-width:25rem;color:#765d64}.photos h2,.details-title{font:400 clamp(3.4rem,8vw,7.5rem)/.95 var(--serif);letter-spacing:-.07em;margin:0}.photos h2 em,.details-title em{color:var(--rose)}.photo-frame{aspect-ratio:1;display:grid;place-items:center;align-content:center;gap:1rem;border:1px solid var(--gold);background:var(--blush);color:var(--rose);transform:rotate(3deg)}.photo-frame span{font:5rem var(--serif)}.photo-frame small{letter-spacing:.14em;text-transform:uppercase;font-size:.65rem}.rsvp h2 em{color:#f3d2a4}.details{background:var(--cream);color:var(--ink)}.details .eyebrow{color:var(--rose)}.details-title{margin-bottom:4rem}.detail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;background:transparent;max-width:950px}.detail-grid article{position:relative;min-height:310px;background:#fffdfb;border:1px solid #dfc7bd;padding:2.5rem;box-shadow:10px 10px 0 var(--blush)}.detail-symbol{color:var(--gold);font:2rem var(--serif)}.detail-grid h3{margin:2.5rem 0 1.3rem;color:var(--ink)}.detail-grid h3 em{color:var(--rose)}.detail-grid p{color:#765d64;max-width:18rem}.detail-grid p strong{color:var(--ink);font:italic 1.1rem var(--serif)}.guest-field{display:block;margin:2rem auto .5rem;color:#f4e1e2;font-size:.78rem}.guest-input{width:min(100%,320px);padding:.9rem 1rem;border:1px solid #f4e1e2;border-radius:0;background:transparent;color:#fff8f3;font:inherit;text-align:center}.guest-input::placeholder{color:#f4e1e2aa}.guest-input:focus{outline:2px solid #f3d2a4;outline-offset:3px}.color-word{color:var(--gold);font-family:var(--serif);font-style:italic}.reserved-colors{display:inline-flex;align-items:center;gap:.18rem;font-family:var(--serif);font-style:italic;font-weight:500;white-space:nowrap}.rose-word{color:#b96f86}.gold-word{color:#b18445}@media(max-width:700px){.photos-grid,.detail-grid{grid-template-columns:1fr}}
.cover-art{background-image:url('https://commons.wikimedia.org/wiki/Special:FilePath/Colombia%2C_Cartagena%2C_Castillo_de_San_Felipe_de_Barajas.jpg')}.cover h1{font-size:clamp(7rem,25vw,13rem);letter-spacing:.03em;margin:.8rem 0;color:#f0c98d}.name{font:italic clamp(4.5rem,16vw,10rem)/.85 'Parisienne',cursive;letter-spacing:.01em;text-transform:none;margin:3.5rem 0 1.15rem;color:#fffdf8;text-shadow:0 2px 18px #35152299}.surname{margin:0;color:#f7dfc9;font-size:.8rem;letter-spacing:.38em;text-transform:uppercase}.date{margin-top:1.6rem;color:#f8e7d6}.photo-credit{margin:1rem auto 0;font-size:.62rem;color:#a48b8f}.photo-credit a{color:inherit}
.cover-art{z-index:0;background-image:url('https://commons.wikimedia.org/wiki/Special:FilePath/Colombia%2C_Cartagena%2C_Castillo_de_San_Felipe_de_Barajas.jpg')}.cover-video{display:none;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.72);z-index:0}.cover:after{z-index:1}.cover-copy{z-index:2}.cover h1{font-size:clamp(6rem,20vw,10rem);margin:1rem 0}.name{font-size:clamp(5rem,18vw,12rem);margin:4.2rem 0 1.5rem;background:linear-gradient(110deg,#fff8ef 12%,#f0c98d 35%,#fffdf8 48%,#d8a65f 62%,#fff7e9 80%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:none;animation:name-shine 4.5s ease-in-out infinite}@keyframes name-shine{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}.surname{margin-top:0}.date{margin-top:2rem}.scroll-arrow{margin-top:5rem}@media(max-width:700px){.cover-art{display:none}.cover-video{display:block}}
</style>
